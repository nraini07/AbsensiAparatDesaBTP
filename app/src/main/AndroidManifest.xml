<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.absensiaparatbtp">

    <!-- Izin lokasi untuk GPS -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:allowBackup="false"
        android:label="Absensi Aparat Desa BTP"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar">

        <activity android:name=".LoginActivity" />
        <activity android:name=".AdminDashboardActivity" />
        <activity android:name=".LaporanAbsensiActivity" />
        <activity android:name=".LaporanDetailPegawaiActivity" />
        <activity android:name=".ProfilPenggunaActivity" />

        <activity android:name=".PegawaiDashboardActivity" />
        <activity android:name=".RegisterActivity" />
        <activity android:name=".AbsensiHariIniActivity" />
        <activity android:name=".RiwayatAbsensiActivity" />
        <activity android:name=".EditProfilPegawaiActivity" />

        <activity
            android:name=".WelcomeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>