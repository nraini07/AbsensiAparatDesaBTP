<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center_horizontal"
    android:background="#F5F5F5">

    <!-- Greeting ADMIN -->
    <TextView
        android:id="@+id/tvHaloAdmin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SELAMAT DATANG, ADMIN"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textAlignment="center"
        android:textColor="#BA000000"
        android:layout_marginBottom="8dp" />

    <!-- Garis pemisah -->
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="#1976D2"
        android:layout_marginBottom="24dp" />

    <!-- Menu 1: Laporan Absensi -->
    <LinearLayout
        android:id="@+id/btnLaporanAbsensi"
        android:layout_width="match_parent"
        android:layout_height="139dp"
        android:layout_marginBottom="16dp"
        android:background="#4CAF50"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"
            android:contentDescription="Laporan Absensi"
            android:src="@drawable/ic_laporan_absensi" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="LAPORAN ABSENSI"
            android:textAlignment="center"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Lihat laporan absensi pegawai"
            android:textAlignment="center"
            android:textColor="#E0E0E0"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Menu 2: Profil Pengguna -->
    <LinearLayout
        android:id="@+id/btnProfilPengguna"
        android:layout_width="match_parent"
        android:layout_height="135dp"
        android:layout_marginBottom="16dp"
        android:background="#4CAF50"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"
            android:contentDescription="Profil Pengguna"
            android:src="@drawable/ic_profil_pengguna" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PROFIL PENGGUNA"
            android:textAlignment="center"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Kelola profil pegawai"
            android:textAlignment="center"
            android:textColor="#E0E0E0"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Spacer biar tombol logout agak ke bawah -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Tombol LOGOUT di sisi kanan bawah (dalam LinearLayout) -->
    <ImageButton
        android:id="@+id/btnLogoutAdmin"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="end"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_logout_circle"
        android:padding="12dp"
        android:contentDescription="Logout"
        android:src="@drawable/ic_logout" />

</LinearLayout>