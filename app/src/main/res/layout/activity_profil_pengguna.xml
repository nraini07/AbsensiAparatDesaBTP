<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FFFFFF">

    <!-- Bar atas: tombol back + judul -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tvBackProfil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/back_arrow"
            android:textSize="24sp"
            android:padding="4dp"
            android:textColor="#000000" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="PROFIL PEGAWAI"
            android:textStyle="bold"
            android:textSize="18sp"
            android:gravity="center"
            android:textColor="#000000" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#000000"
        android:layout_marginBottom="12dp" />

    <!-- SearchView untuk cari pegawai -->
    <SearchView
        android:id="@+id/searchViewProfil"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_edittext_round"
        android:iconifiedByDefault="false"
        android:queryHint="Cari nama atau No Telp pegawai..."
        />

    <!-- RecyclerView untuk profil pegawai -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvProfilPegawai"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>