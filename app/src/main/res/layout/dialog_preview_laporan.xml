<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FFFFFF">

    <!-- KOP SURAT DENGAN LOGO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="8dp"
        android:gravity="center_vertical">

        <!-- Logo -->
        <ImageView
            android:id="@+id/imgLogoDesa"
            android:layout_width="60dp"
            android:layout_height="70dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/logoasli"
            android:scaleType="fitCenter" />

        <!-- Teks kop surat -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/tvKopKabupaten"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PEMERINTAH KABUPATEN MAMUJU"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#000000"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvKopKecamatan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="KECAMATAN MAMUJU"
                android:textStyle="bold"
                android:textSize="13sp"
                android:textColor="#000000"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvKopDesa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DESA BATU PANNU"
                android:textStyle="bold"
                android:textSize="13sp"
                android:textColor="#000000"
                android:gravity="center" />
        </LinearLayout>
    </LinearLayout>

    <!-- Garis tebal di bawah kop surat -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1.5dp"
        android:background="#000000"
        android:layout_marginBottom="8dp" />

    <!-- JUDUL: DAFTAR HADIR -->
    <TextView
        android:id="@+id/tvJudulLaporan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="LAPORAN ABSENSI"
        android:textStyle="bold"
        android:textSize="15sp"
        android:gravity="center"
        android:textColor="#000000"
        android:layout_marginBottom="2dp" />

    <!-- Subjudul opsional -->
    <TextView
        android:id="@+id/tvSubJudulLaporan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="APARAT DESA BATU PANNU"
        android:textStyle="bold"
        android:textSize="12sp"
        android:gravity="center"
        android:textColor="#000000"
        android:layout_marginBottom="4dp" />

    <!-- Periode -->
    <TextView
        android:id="@+id/tvPeriodePreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Periode: -"
        android:textSize="11sp"
        android:gravity="center"
        android:textColor="#000000"
        android:layout_marginBottom="8dp" />

    <!-- Header tabel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2.4"
            android:text="NAMA"
            android:textStyle="bold"
            android:textSize="9sp"
            android:textColor="#000000"
            android:paddingHorizontal="2dp"
            android:paddingVertical="3dp"
            android:background="@drawable/bg_table_header_cell" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.1"
            android:text="MASUK"
            android:textStyle="bold"
            android:textSize="9sp"
            android:gravity="center"
            android:textColor="#000000"
            android:paddingHorizontal="2dp"
            android:paddingVertical="3dp"
            android:background="@drawable/bg_table_header_cell" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.1"
            android:text="IZIN"
            android:textStyle="bold"
            android:textSize="9sp"
            android:gravity="center"
            android:textColor="#000000"
            android:paddingHorizontal="2dp"
            android:paddingVertical="3dp"
            android:background="@drawable/bg_table_header_cell" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.1"
            android:text="SAKIT"
            android:textStyle="bold"
            android:textSize="9sp"
            android:gravity="center"
            android:textColor="#000000"
            android:paddingHorizontal="2dp"
            android:paddingVertical="3dp"
            android:background="@drawable/bg_table_header_cell" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.1"
            android:text="KELUAR"
            android:textStyle="bold"
            android:textSize="9sp"
            android:gravity="center"
            android:textColor="#000000"
            android:paddingHorizontal="2dp"
            android:paddingVertical="3dp"
            android:background="@drawable/bg_table_header_cell" />
    </LinearLayout>

    <!-- Isi tabel -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPreviewLaporan"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginBottom="8dp" />

    <!-- Baris TOTAL -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="3"
            android:text="TOTAL"
            android:textStyle="bold"
            android:textSize="9sp"
            android:gravity="center"
            android:textColor="#000000"
            android:paddingHorizontal="2dp"
            android:paddingVertical="3dp"
            android:background="@drawable/bg_table_header_cell" />

        <TextView
            android:id="@+id/tvPreviewTotalMasuk"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.3"
            android:text="0"
            android:textSize="9sp"
            android:gravity="center"
            android:textColor="#000000"
            android:paddingHorizontal="2dp"
            android:paddingVertical="3dp"
            android:background="@drawable/bg_table_header_cell" />

        <TextView
            android:id="@+id/tvPreviewTotalIzin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.3"
            android:text="0"
            android:textSize="9sp"
            android:gravity="center"
            android:textColor="#000000"
            android:paddingHorizontal="2dp"
            android:paddingVertical="3dp"
            android:background="@drawable/bg_table_header_cell" />

        <TextView
            android:id="@+id/tvPreviewTotalSakit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.3"
            android:text="0"
            android:textSize="9sp"
            android:gravity="center"
            android:textColor="#000000"
            android:paddingHorizontal="2dp"
            android:paddingVertical="3dp"
            android:background="@drawable/bg_table_header_cell" />

        <TextView
            android:id="@+id/tvPreviewTotalKeluar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.3"
            android:text="0"
            android:textSize="9sp"
            android:gravity="center"
            android:textColor="#000000"
            android:paddingHorizontal="2dp"
            android:paddingVertical="3dp"
            android:background="@drawable/bg_table_header_cell" />
    </LinearLayout>

</LinearLayout>