<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FFFFFF">

    <!-- Judul dialog -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="LAPORAN ABSENSI APARAT"
        android:textStyle="bold"
        android:textSize="18sp"
        android:gravity="center"
        android:textColor="#000000"
        android:layout_marginBottom="4dp" />

    <!-- KOP SURAT -->
    <TextView
        android:id="@+id/tvKopPreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:gravity="center"
        android:text=" DESA BATU PANNU KECAMATAN MAMUJU"
        android:textColor="#000000"
        android:textSize="12sp"
        android:textStyle="bold" />


    <!-- Periode -->
    <TextView
        android:id="@+id/tvPeriodePreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Periode: -"
        android:textSize="11sp"
        android:gravity="center"
        android:textColor="#000000"
        android:layout_marginBottom="8dp" />

    <!-- Header tabel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2.4"
            android:text="NAMA"
            android:textStyle="bold"
            android:textSize="9sp"
            android:textColor="#000000"
            android:paddingHorizontal="2dp"
            android:paddingVertical="3dp"
            android:background="@drawable/bg_table_header_cell" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.1"
            android:text="MASUK"
            android:textStyle="bold"
            android:textSize="9sp"
            android:gravity="center"
            android:textColor="#000000"
            android:paddingHorizontal="2dp"
            android:paddingVertical="3dp"
            android:background="@drawable/bg_table_header_cell" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.1"
            android:text="IZIN"
            android:textStyle="bold"
            android:textSize="9sp"
            android:gravity="center"
            android:textColor="#000000"
            android:paddingHorizontal="2dp"
            android:paddingVertical="3dp"
            android:background="@drawable/bg_table_header_cell" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.1"
            android:text="SAKIT"
            android:textStyle="bold"
            android:textSize="9sp"
            android:gravity="center"
            android:textColor="#000000"
            android:paddingHorizontal="2dp"
            android:paddingVertical="3dp"
            android:background="@drawable/bg_table_header_cell" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.1"
            android:text="KELUAR"
            android:textStyle="bold"
            android:textSize="9sp"
            android:gravity="center"
            android:textColor="#000000"
            android:paddingHorizontal="2dp"
            android:paddingVertical="3dp"
            android:background="@drawable/bg_table_header_cell" />
    </LinearLayout>

    <!-- Isi tabel -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPreviewLaporan"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginBottom="8dp" />

    <!-- Baris TOTAL -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="3"
            android:text="TOTAL"
            android:textStyle="bold"
            android:textSize="9sp"
            android:gravity="center"
            android:textColor="#000000"
            android:paddingHorizontal="2dp"
            android:paddingVertical="3dp"
            android:background="@drawable/bg_table_header_cell" />

        <TextView
            android:id="@+id/tvPreviewTotalMasuk"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.3"
            android:text="0"
            android:textSize="9sp"
            android:gravity="center"
            android:textColor="#000000"
            android:paddingHorizontal="2dp"
            android:paddingVertical="3dp"
            android:background="@drawable/bg_table_header_cell" />

        <TextView
            android:id="@+id/tvPreviewTotalIzin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.3"
            android:text="0"
            android:textSize="9sp"
            android:gravity="center"
            android:textColor="#000000"
            android:paddingHorizontal="2dp"
            android:paddingVertical="3dp"
            android:background="@drawable/bg_table_header_cell" />

        <TextView
            android:id="@+id/tvPreviewTotalSakit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.3"
            android:text="0"
            android:textSize="9sp"
            android:gravity="center"
            android:textColor="#000000"
            android:paddingHorizontal="2dp"
            android:paddingVertical="3dp"
            android:background="@drawable/bg_table_header_cell" />

        <TextView
            android:id="@+id/tvPreviewTotalKeluar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.3"
            android:text="0"
            android:textSize="9sp"
            android:gravity="center"
            android:textColor="#000000"
            android:paddingHorizontal="2dp"
            android:paddingVertical="3dp"
            android:background="@drawable/bg_table_header_cell" />
    </LinearLayout>

    <!-- Tombol CETAK / UNDUH -->
    <Button
        android:id="@+id/btnCetakUnduh"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CETAK / UNDUH"
        android:backgroundTint="#4CAF50"
        android:textColor="#000000"
        android:layout_marginTop="12dp" />

</LinearLayout>