<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="#FFFFFF"
    android:layout_marginBottom="4dp">

    <!-- Baris: Nama | Tanggal | Jam | Status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Nama -->
        <TextView
            android:id="@+id/tvNamaDetail"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="Nama Pegawai"
            android:textStyle="bold"
            android:textSize="13sp"
            android:textColor="#000000" />

        <!-- Tanggal -->
        <TextView
            android:id="@+id/tvTanggalDetail"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.5"
            android:text="00-00-0000"
            android:gravity="center"
            android:textSize="12sp"
            android:textColor="#000000" />

        <!-- Jam -->
        <TextView
            android:id="@+id/tvWaktuDetail"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="00:00"
            android:gravity="center"
            android:textSize="12sp"
            android:textColor="#000000" />

        <!-- Status (Jenis Absensi) -->
        <TextView
            android:id="@+id/tvStatusDetail"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.5"
            android:text="Masuk"
            android:gravity="center_horizontal"
            android:textSize="12sp"
            android:textColor="#000000" />
    </LinearLayout>

    <!-- Baris Catatan (di bawah) -->
    <TextView
        android:id="@+id/tvCatatanDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Keterangan tambahan"
        android:textSize="12sp"
        android:textColor="#000000"
        android:layout_marginTop="2dp" />

    <!-- Baris Lokasi + Status Area Tugas (di bawah) -->
    <TextView
        android:id="@+id/tvLokasiDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Lokasi: ..."
        android:textSize="12sp"
        android:textColor="#000000"
        android:layout_marginTop="2dp" />

</LinearLayout>