<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F5F5F5">

    <!-- Bar atas: Back + Judul -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">


        <TextView
            android:id="@+id/tvBackLaporan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/back_arrow"
            android:textSize="24sp"
            android:padding="4dp"
            android:textColor="@android:color/black"
            android:textColorHint="@android:color/darker_gray" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="LAPORAN ABSENSI PEGAWAI"
            android:textStyle="bold"
            android:textSize="18sp"
            android:gravity="center"
            android:textColor="@android:color/black"
            android:textColorHint="@android:color/darker_gray" />
    </LinearLayout>

    <!-- Filter: Bulan & Tahun -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <Spinner
            android:id="@+id/spinnerBulanLaporan"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:background="@drawable/bg_edittext_round"
            android:padding="8dp"
            android:textSize="12sp"
            android:popupBackground="@android:color/white" />

        <Spinner
            android:id="@+id/spinnerTahunLaporan"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_edittext_round"
            android:padding="8dp"
            android:textSize="12sp"
            android:popupBackground="@android:color/white" />
    </LinearLayout>

    <!-- Search Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <EditText
            android:id="@+id/etSearchPegawai"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_edittext_round"
            android:hint="Cari nama..."
            android:padding="8dp"
            android:textSize="12sp"
            android:textColor="@android:color/black"
            android:textColorHint="@android:color/black" />
    </LinearLayout>

    <!-- Tabel Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:padding="8dp"
        android:layout_marginBottom="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2.5"
            android:text="NAMA"
            android:textStyle="bold"
            android:textSize="11sp"
            android:textColor="#000000" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.1"
            android:text="MASUK"
            android:textStyle="bold"
            android:textSize="11sp"
            android:gravity="center"
            android:textColor="#000000" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.1"
            android:text="IZIN"
            android:textStyle="bold"
            android:textSize="11sp"
            android:gravity="center"
            android:textColor="#000000" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.1"
            android:text="SAKIT"
            android:textStyle="bold"
            android:textSize="11sp"
            android:gravity="center"
            android:textColor="#000000" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.1"
            android:text="KELUAR"
            android:textStyle="bold"
            android:textSize="11sp"
            android:gravity="center"
            android:textColor="#000000" />
    </LinearLayout>

    <!-- Garis pemisah -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#CCCCCC"
        android:layout_marginBottom="4dp" />

    <!-- RecyclerView untuk data pegawai -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvLaporanAbsensi"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="12dp" />

    <!-- Baris TOTAL -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#F0F0F0"
        android:padding="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2.5"
            android:text="TOTAL"
            android:textStyle="bold"
            android:textSize="12sp"
            android:gravity="center"
            android:textColor="#000000" />

        <TextView
            android:id="@+id/tvTotalMasuk"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.1"
            android:text="0"
            android:textSize="11sp"
            android:gravity="center"
            android:textColor="#000000" />

        <TextView
            android:id="@+id/tvTotalIzin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.1"
            android:text="0"
            android:textSize="11sp"
            android:gravity="center"
            android:textColor="#000000" />

        <TextView
            android:id="@+id/tvTotalSakit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.1"
            android:text="0"
            android:textSize="11sp"
            android:gravity="center"
            android:textColor="#000000" />

        <TextView
            android:id="@+id/tvTotalKeluar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.1"
            android:text="0"
            android:textSize="11sp"
            android:gravity="center"
            android:textColor="#000000" />
    </LinearLayout>

    <!-- Button Unduh Laporan -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="12dp">

        <Button
            android:id="@+id/btnUnduhPDF"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:backgroundTint="#4CAF50"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="📥 UNDUH LAPORAN"
            android:textAllCaps="false" />
    </LinearLayout>

</LinearLayout>