<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="#FFFFFF"
    android:layout_marginBottom="4dp">

    <!-- Baris: Nama | Masuk | Izin | Sakit | Keluar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Nama Pegawai (clickable untuk lihat detail) -->
        <TextView
            android:id="@+id/tvNamaLaporan"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="3"
            android:text="Nama Pegawai"
            android:textStyle="bold"
            android:textSize="13sp"
            android:textColor="#000000" />

        <!-- Masuk -->
        <TextView
            android:id="@+id/tvMasukLaporan"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0"
            android:gravity="center"
            android:textSize="12sp"
            android:textColor="#000000" />

        <!-- Izin -->
        <TextView
            android:id="@+id/tvIzinLaporan"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0"
            android:gravity="center"
            android:textSize="12sp"
            android:textColor="#000000" />

        <!-- Sakit -->
        <TextView
            android:id="@+id/tvSakitLaporan"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0"
            android:gravity="center"
            android:textSize="12sp"
            android:textColor="#000000" />

        <!-- Keluar -->
        <TextView
            android:id="@+id/tvKeluarLaporan"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0"
            android:gravity="center"
            android:textSize="12sp"
            android:textColor="#000000" />
    </LinearLayout>

</LinearLayout>