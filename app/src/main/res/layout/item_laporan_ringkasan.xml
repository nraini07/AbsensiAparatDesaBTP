<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="#FFFFFF">

    <!-- NAMA -->
    <TextView
        android:id="@+id/tvNamaRingkasan"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2.3"
        android:text="Nama Pegawai"
        android:textSize="9sp"
        android:textColor="#000000"
        android:paddingVertical="3dp"
        android:paddingHorizontal="2dp"
        android:background="@drawable/bg_table_cell" />

    <!-- MASUK -->
    <TextView
        android:id="@+id/tvMasukRingkasan"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="0"
        android:textSize="9sp"
        android:gravity="center"
        android:textColor="#000000"
        android:paddingVertical="3dp"
        android:paddingHorizontal="2dp"
        android:background="@drawable/bg_table_cell" />

    <!-- IZIN -->
    <TextView
        android:id="@+id/tvIzinRingkasan"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="0"
        android:textSize="9sp"
        android:gravity="center"
        android:textColor="#000000"
        android:paddingVertical="3dp"
        android:paddingHorizontal="2dp"
        android:background="@drawable/bg_table_cell" />

    <!-- SAKIT -->
    <TextView
        android:id="@+id/tvSakitRingkasan"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="0"
        android:textSize="9sp"
        android:gravity="center"
        android:textColor="#000000"
        android:paddingVertical="3dp"
        android:paddingHorizontal="2dp"
        android:background="@drawable/bg_table_cell" />

    <!-- KELUAR -->
    <TextView
        android:id="@+id/tvKeluarRingkasan"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="0"
        android:textSize="9sp"
        android:gravity="center"
        android:textColor="#000000"
        android:paddingVertical="3dp"
        android:paddingHorizontal="2dp"
        android:background="@drawable/bg_table_cell" />

</LinearLayout>